<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Windows Authentication (SQL Server Express) -->
        <add name="HastaneDb"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=HastaneProje;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
        <!-- SQL Server Authentication örneği:
        <add name="HastaneDb"
             connectionString="Data Source=localhost,1433;Initial Catalog=HastaneProje;User ID=sa;Password=YOUR_PASSWORD;Encrypt=False;"
             providerName="System.Data.SqlClient" />
        -->
    </connectionStrings>
</configuration>
